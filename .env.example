# Fournisseur principal — NVIDIA Build (API compatible OpenAI).
# Toujours tenté en premier. Laisser vide pour désactiver NVIDIA et
# passer directement au niveau suivant (fonctionnement inchangé).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-v4.1-flash
NVIDIA_TIMEOUT_SECONDS=12

# Fournisseur secondaire (fallback automatique n°1 si NVIDIA échoue).
# Laisser vide pour un fonctionnement 100% local (réponses gabarit) au
# niveau suivant. Exemple avec Groq (API gratuite, quota généreux) :
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
